{
  "functions": {
    "api/**/*.php": {
      "runtime": "vercel-php@0.8.0"
    }
  },
  "routes": [
    { "src": "/login.php", "dest": "/api/login.php" },
    { "src": "/admin/(.*)", "dest": "/api/admin/$1" },
    { "src": "/vistas/(.*)", "dest": "/api/vistas/$1" },
    { "src": "/includes/(.*)", "dest": "/api/includes/$1" },
    { "handle": "filesystem" },
    { "src": "/(.*)", "dest": "/api/$1" }
  ]
}